@page "/library"
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Library</PageTitle>

@if (_notice is not null)
{
    <div class="notice-box" role="status">@_notice</div>
}

<section class="panel">
    <h1>Bible versions</h1>
    <p class="muted">Installed translations stay on this device.</p>
    <a class="primary-btn" href="import">Import file</a>

    @if (_loading)
    {
        <LoadingSpinner />
    }
    else if (_error is not null)
    {
        <ErrorDisplay Message="@_error" />
    }
    else if (_versions.Count == 0)
    {
        <p>No translations installed.</p>
        <a class="primary-btn" href="import">Import</a>
    }
    else
    {
        @foreach (var version in _versions)
        {
            var isActive = version.Id == _activeVersionId;
            <article class="version-card @(isActive ? "active" : null)">
                <strong>@version.Title</strong>
                @if (isActive)
                {
                    <span class="muted"> · Reading</span>
                }
                @if (version.Id == _defaultVersionId)
                {
                    <span class="default-badge">Default</span>
                }
                <p class="muted">@version.Language · @version.TotalBooks books</p>
                @if (!string.IsNullOrWhiteSpace(version.Description))
                {
                    <p>@version.Description</p>
                }
                @if (!string.IsNullOrWhiteSpace(version.License))
                {
                    <p class="muted">@version.License</p>
                }
                <div class="row-actions">
                    <button type="button" class="primary-btn" @onclick="() => OpenVersion(version.Id)">Open</button>
                    @if (version.Id != _defaultVersionId)
                    {
                        <button type="button" class="text-btn" @onclick="() => SetDefault(version.Id)">Set as default</button>
                    }
                    @if (_confirmDeleteId == version.Id)
                    {
                        <button type="button" class="danger-btn" @onclick="() => Delete(version.Id)">Confirm delete</button>
                        <button type="button" class="text-btn" @onclick="() => _confirmDeleteId = null">Cancel</button>
                    }
                    else
                    {
                        <button type="button" class="danger-btn" @onclick="() => _confirmDeleteId = version.Id">Delete</button>
                    }
                </div>
                @if (_bookmarks.TryGetValue(version.Id, out var bookmarks) && bookmarks.Count > 0)
                {
                    <h2>Bookmarks</h2>
                    @foreach (var bookmark in bookmarks)
                    {
                        <button type="button" class="bookmark-row" @onclick="() => OpenBookmark(bookmark)">
                            @bookmark.BookName @bookmark.Chapter:@bookmark.Verse
                        </button>
                    }
                }
            </article>
        }
    }
</section>

<section class="panel">
    <h2>Data management</h2>
    <div class="row-actions" style="flex-direction: column; gap: 8px;">
        @if (_confirmClearHistory)
        {
            <div style="padding: 12px; background: #fff3cd; border-radius: 4px;">
                <p style="margin: 0 0 8px 0; font-size: 14px;">Clear all bookmarks and reading history? (Translations stay)</p>
                <button type="button" class="danger-btn" @onclick="ClearReadingHistoryAsync">Confirm</button>
                <button type="button" class="text-btn" @onclick="() => _confirmClearHistory = false">Cancel</button>
            </div>
        }
        else
        {
            <button type="button" class="danger-btn" @onclick="() => _confirmClearHistory = true" style="justify-content: flex-start;">
                🗑️ Clear reading history & bookmarks
            </button>
        }

        @if (_confirmFactoryReset)
        {
            <div style="padding: 12px; background: #f8d7da; border-radius: 4px;">
                <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: bold;">⚠️ This will delete ALL data including all translations. Continue?</p>
                <button type="button" class="danger-btn" @onclick="FactoryResetAsync">Confirm reset everything</button>
                <button type="button" class="text-btn" @onclick="() => _confirmFactoryReset = false">Cancel</button>
            </div>
        }
        else
        {
            <button type="button" class="danger-btn" @onclick="() => _confirmFactoryReset = true" style="justify-content: flex-start;">
                ⚠️ Factory reset (delete everything)
            </button>
        }
    </div>
</section>

<section class="panel">
    <VersionCatalog OnInstalled="LoadAsync" />
</section>

@code {
    private IReadOnlyList<BibleVersionDto> _versions = [];
    private Dictionary<string, IReadOnlyList<BookmarkDto>> _bookmarks = new(StringComparer.OrdinalIgnoreCase);
    private string? _activeVersionId;
    private string? _defaultVersionId;
    private string? _confirmDeleteId;
    private bool _confirmClearHistory;
    private bool _confirmFactoryReset;
    private string? _error;
    private string? _notice;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _notice = null;
        var versions = await Mediator.Send(new GetInstalledVersionsQuery());
        if (!versions.IsSuccess || versions.Value is null)
        {
            _error = versions.Error ?? "Could not load the library.";
            _loading = false;
            return;
        }

        _versions = versions.Value;
        _bookmarks = new Dictionary<string, IReadOnlyList<BookmarkDto>>(StringComparer.OrdinalIgnoreCase);
        ReadingPositionDto? newest = null;

        foreach (var version in _versions)
        {
            var bookmarks = await Mediator.Send(new GetBookmarksQuery(version.Id));
            _bookmarks[version.Id] = bookmarks.IsSuccess && bookmarks.Value is not null
                ? bookmarks.Value
                : [];

            var position = await Mediator.Send(new GetReadingPositionQuery(version.Id));
            if (position.IsSuccess && position.Value is not null &&
                (newest is null || position.Value.LastReadAt > newest.LastReadAt))
            {
                newest = position.Value;
            }
        }

        _activeVersionId = newest?.VersionId ?? _versions.FirstOrDefault()?.Id;
        var preferred = await Mediator.Send(new GetDefaultVersionQuery());
        _defaultVersionId = preferred.IsSuccess ? preferred.Value : null;
        _loading = false;
    }

    private async Task SetDefault(string versionId)
    {
        var result = await Mediator.Send(new SetDefaultVersionCommand(versionId));
        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        _defaultVersionId = versionId;
    }

    private async Task OpenVersion(string versionId)
    {
        var position = await Mediator.Send(new GetReadingPositionQuery(versionId));
        if (position.IsSuccess && position.Value is not null)
        {
            Navigation.NavigateTo($"/read/{versionId}/{(int)position.Value.BookId}/{position.Value.Chapter}");
            return;
        }

        Navigation.NavigateTo($"/read/{versionId}/0/1");
    }

    private void OpenBookmark(BookmarkDto bookmark)
    {
        Navigation.NavigateTo($"/read/{bookmark.VersionId}/{(int)bookmark.BookId}/{bookmark.Chapter}/{bookmark.Verse}");
    }

    private async Task Delete(string versionId)
    {
        var result = await Mediator.Send(new DeleteVersionCommand(versionId));
        _confirmDeleteId = null;
        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        await LoadAsync();
    }

    private async Task ClearReadingHistoryAsync()
    {
        _loading = true;
        _error = null;
        _notice = null;
        _confirmClearHistory = false;

        try
        {
            // Clear all bookmarks, highlights, and reading positions for all versions
            foreach (var version in _versions)
            {
                await Mediator.Send(new ClearReadingPositionCommand(version.Id));
                await Mediator.Send(new ClearBookmarksCommand(version.Id));
                await Mediator.Send(new ClearHighlightsCommand(version.Id));
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to clear history: {ex.Message}";
            _loading = false;
        }
    }

    private async Task FactoryResetAsync()
    {
        _loading = true;
        _error = null;
        _notice = null;
        _confirmFactoryReset = false;

        try
        {
            // Delete all versions (cascades to delete bookmarks and positions)
            foreach (var version in _versions.ToList())
            {
                await Mediator.Send(new DeleteVersionCommand(version.Id));
            }

            // Clear all preferences
            await JS.InvokeVoidAsync("openBibleDisplay.reset");
            await JS.InvokeVoidAsync("openBibleTheme.set", "system");

            _versions = [];
            _bookmarks.Clear();
            _activeVersionId = null;
            _defaultVersionId = null;
            _loading = false;
            _notice = "All data cleared. App reset to factory defaults.";
        }
        catch (Exception ex)
        {
            _notice = null;
            _error = $"Failed to reset: {ex.Message}";
            _loading = false;
        }
    }
}

