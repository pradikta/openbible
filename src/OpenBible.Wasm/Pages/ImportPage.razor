@page "/import"
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Import</PageTitle>

<section class="panel">
    <h1>Import</h1>
    <p class="muted">Add a translation file (.yes, .yes.gz, USFM, or a ZIP). Parsing and storage stay on this device.</p>
    <InputFile OnChange="OnFileSelected" class="file-field" />

    @if (_busy)
    {
        @if (_progress is null || _progress.TotalVerses == 0)
        {
            <LoadingSpinner />
        }
        else
        {
            <div class="import-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Percent">
                <p class="muted">@StatusText</p>
                <div style="height:0.5rem;overflow:hidden;border-radius:9999px;background:var(--ob-border)">
                    <div style="height:100%;border-radius:9999px;background:var(--ob-accent);width:@(Percent)%;transition:width 0.15s ease"></div>
                </div>
            </div>
        }
    }
    else if (_preview is { IsSuccess: true, Value: not null })
    {
        <article class="version-card">
            <strong>@_preview.Value.Title</strong>
            <p class="muted">@_preview.Value.Language · @_preview.Value.TotalBooks books</p>
            @if (!string.IsNullOrWhiteSpace(_preview.Value.Description))
            {
                <p>@_preview.Value.Description</p>
            }
            <div class="row-actions">
                <button type="button" class="primary-btn" @onclick="ImportAsync">Import</button>
            </div>
        </article>
    }
    else if (_preview is { IsFailure: true })
    {
        <ErrorDisplay Message="@_preview.Error" />
    }

    @if (!string.IsNullOrWhiteSpace(_importError))
    {
        <ErrorDisplay Message="@_importError" />
    }
</section>

@code {
    private const long MaxBytes = 64L * 1024L * 1024L;

    private IBrowserFile? _file;
    private Result<BibleVersionDto>? _preview;
    private string? _importError;
    private bool _busy;
    private ImportProgress? _progress;
    private BibleFormat _previewFormat = BibleFormat.Yes;
    private readonly IProgress<ImportProgress> _importProgress;

    public ImportPage()
    {
        _importProgress = new Progress<ImportProgress>(OnProgress);
    }

    private int Percent => _progress is null ? 0 : (int)Math.Round(_progress.Fraction * 100);

    private string StatusText
    {
        get
        {
            var progress = _progress;
            if (progress is null)
            {
                return "Importing...";
            }

            return progress.Stage switch
            {
                ImportStage.ReadingMetadata => "Reading file metadata...",
                ImportStage.SavingVerses => $"Saving verses... {progress.ProcessedVerses:N0} / {progress.TotalVerses:N0}",
                ImportStage.IndexingVerses => $"Building search index... {progress.ProcessedVerses:N0} / {progress.TotalVerses:N0}",
                ImportStage.Completed => "Import complete.",
                _ => "Importing..."
            };
        }
    }

    private void OnProgress(ImportProgress progress)
    {
        _progress = progress;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        _file = args.File;
        _importError = null;
        _progress = null;
        _previewFormat = BibleFormat.Yes;

        var fileName = _file.Name.ToLowerInvariant();
        if (!fileName.EndsWith(".yes")
            && !fileName.EndsWith(".yes.gz")
            && !fileName.EndsWith(".gz")
            && !fileName.EndsWith(".usfm")
            && !fileName.EndsWith(".sfm")
            && !fileName.EndsWith(".zip"))
        {
            _importError = "Only .yes, .yes.gz, .usfm, .sfm, or .zip files are supported.";
            _file = null;
            _preview = null;
            return;
        }

        _busy = true;
        await using var stream = await OpenSeekableAsync(_file);
        _preview = await Mediator.Send(new PreviewYesFileQuery(stream, _file.Name));
        if (_preview is { IsSuccess: true, Value: not null })
        {
            _previewFormat = _preview.Value.Format;
        }

        _busy = false;
    }

    private async Task ImportAsync()
    {
        if (_file is null)
        {
            return;
        }

        _busy = true;
        _importError = null;
        _progress = new ImportProgress(ImportStage.ReadingMetadata, 0, 0);
        await using var stream = await OpenSeekableAsync(_file);
        var result = await Mediator.Send(new ImportYesFileCommand(stream, _file.Name, _importProgress, _previewFormat));
        _busy = false;
        _progress = null;

        if (result.IsSuccess && result.Value is not null)
        {
            Navigation.NavigateTo($"/read/{result.Value.Id}/0/1");
            return;
        }

        _importError = result.Error ?? "Import failed.";
    }

    private static async Task<Stream> OpenSeekableAsync(IBrowserFile file)
    {
        var browserStream = file.OpenReadStream(MaxBytes);
        if (browserStream.CanSeek)
        {
            return browserStream;
        }

        var buffer = new MemoryStream();
        await browserStream.CopyToAsync(buffer);
        await browserStream.DisposeAsync();
        buffer.Position = 0;
        return buffer;
    }
}
