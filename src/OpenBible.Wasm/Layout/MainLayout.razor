@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="min-h-dvh md:flex">
    <aside class="hidden md:sticky md:top-0 md:flex md:h-dvh md:w-60 md:shrink-0 md:flex-col md:gap-6 md:border-r md:border-line md:bg-surface md:px-4 md:py-6">
        <span class="brand px-3">OpenBible</span>
        <NavMenu Sidebar="true" />
        <button type="button" class="theme-btn mt-auto self-start" aria-label="Change theme" @onclick="CycleTheme">Theme: @ThemeLabel</button>
    </aside>

    <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 z-20 flex items-center justify-between gap-4 border-b border-line bg-header px-4 pb-3 backdrop-blur-md pt-[calc(0.75rem+env(safe-area-inset-top))] md:hidden">
            <span class="brand">OpenBible</span>
            <button type="button" class="theme-btn" aria-label="Change theme" @onclick="CycleTheme">@ThemeLabel</button>
        </header>

        <main class="mx-auto w-full max-w-3xl flex-1 px-4 pb-[calc(5.5rem+env(safe-area-inset-bottom))] sm:px-6 md:px-10 md:pb-12">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="exception">
                    <ErrorDisplay Message="@exception.Message" />
                </ErrorContent>
            </ErrorBoundary>
        </main>

        <NavMenu />
    </div>
</div>

@code {
    private ErrorBoundary? _errorBoundary;
    private string _theme = "system";

    private string ThemeLabel => _theme switch
    {
        "dark" => "Dark",
        "light" => "Light",
        _ => "Auto"
    };

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _theme = await JS.InvokeAsync<string>("openBibleTheme.get");
        StateHasChanged();
    }

    private async Task CycleTheme()
    {
        _theme = _theme switch
        {
            "system" => "dark",
            "dark" => "light",
            _ => "system"
        };

        await JS.InvokeVoidAsync("openBibleTheme.set", _theme);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _errorBoundary?.Recover();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
