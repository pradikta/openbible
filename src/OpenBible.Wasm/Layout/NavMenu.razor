@code {
    /// <summary>Bottom tab bar on phones, vertical list inside the sidebar on larger screens.</summary>
    [Parameter] public bool Sidebar { get; set; }

    private string Label => Sidebar ? "Sidebar" : "Primary";

    private string NavClass => Sidebar
        ? "flex flex-col gap-1"
        : "fixed inset-x-0 bottom-0 z-30 grid grid-cols-4 gap-1 border-t border-line bg-header px-2 pt-1.5 backdrop-blur-md pb-[calc(0.4rem+env(safe-area-inset-bottom))] md:hidden";
}
