@inject IMediator Mediator
@inject IJSRuntime JS

@if (Verse is not null)
{
    <div class="sheet-backdrop" @onclick="CloseAsync"></div>
    <div class="sheet" role="dialog" aria-label="Verse actions">
        <div class="sheet-head">
            <strong>@BookName @Chapter:@Verse.VerseNumber</strong>
            <button type="button" class="text-btn" @onclick="CloseAsync">Close</button>
        </div>
        <p class="verse-sheet-text">@Verse.Text</p>
        @if (Verse.Footnotes is { Count: > 0 })
        {
            <h3 class="sheet-sub">Footnotes</h3>
            <ol>
                @foreach (var note in Verse.Footnotes)
                {
                    <li>@note</li>
                }
            </ol>
        }
        <div class="color-row">
            @foreach (var color in Enum.GetValues<HighlightColor>())
            {
                <button type="button"
                        class="swatch @color.ToString().ToLowerInvariant() @(Verse.Highlight == color ? "selected" : null)"
                        aria-label="@color highlight"
                        @onclick="() => Highlight(color)"></button>
            }
        </div>
        <div class="row-actions">
            <button type="button" class="text-btn" @onclick="ToggleBookmark">@(Verse.IsBookmarked ? "Remove bookmark" : "Bookmark")</button>
            <button type="button" class="text-btn" @onclick="Copy">Copy</button>
            <button type="button" class="text-btn" @onclick="Share">Share</button>
        </div>
        <div class="study-box">
            <textarea @bind="_noteText" placeholder="Note" rows="2"></textarea>
            <button type="button" class="text-btn" @onclick="SaveNote">Save note</button>
            @if (_noteId is not null && _labels.Count > 0)
            {
                <div class="label-chips">
                    @foreach (var label in _labels)
                    {
                        <button type="button" class="chip @(_noteLabels.Contains(label.Id) ? "selected" : null)"
                                @onclick="() => ToggleLabel(label.Id)">@label.Name</button>
                    }
                </div>
            }
        </div>
        <div class="row-actions">
            @for (var slot = 1; slot <= 5; slot++)
            {
                var s = slot;
                <button type="button" class="text-btn" @onclick="() => SetMark(s)">Mark @s</button>
            }
            <a class="text-btn" href="@($"compare/{(int)BookId}/{Chapter}/{Verse.VerseNumber}")">Compare</a>
        </div>
        @if (!string.IsNullOrWhiteSpace(_status))
        {
            <p class="muted">@_status</p>
        }
    </div>
}

@code {
    [Parameter] public string VersionId { get; set; } = string.Empty;
    [Parameter] public string BookName { get; set; } = string.Empty;
    [Parameter] public BookId BookId { get; set; }
    [Parameter] public int Chapter { get; set; }
    [Parameter] public VerseDto? Verse { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private string? _status;
    private string _noteText = string.Empty;
    private Guid? _noteId;
    private IReadOnlyList<LabelDto> _labels = [];
    private HashSet<Guid> _noteLabels = [];
    private int _loadedVerse = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (Verse is null)
        {
            _loadedVerse = -1;
            return;
        }

        if (_loadedVerse == Verse.VerseNumber)
        {
            return;
        }

        _loadedVerse = Verse.VerseNumber;
        var notes = await Mediator.Send(new GetNotesQuery(VersionId));
        var note = notes.IsSuccess
            ? notes.Value!.FirstOrDefault(n => n.BookId == BookId && n.Chapter == Chapter && n.Verse == Verse.VerseNumber)
            : null;
        _noteId = note?.Id;
        _noteText = note?.Text ?? string.Empty;
        var labels = await Mediator.Send(new GetLabelsQuery());
        _labels = labels.IsSuccess ? labels.Value! : [];
        await LoadNoteLabelsAsync();
    }

    private async Task LoadNoteLabelsAsync()
    {
        if (_noteId is null)
        {
            _noteLabels = [];
            return;
        }

        var ids = await Mediator.Send(new GetMarkerLabelsQuery(_noteId.Value));
        _noteLabels = ids.IsSuccess ? [.. ids.Value!] : [];
    }

    private async Task SaveNote()
    {
        if (Verse is null)
        {
            return;
        }

        var result = await Mediator.Send(new SaveNoteCommand(VersionId, BookId, Chapter, Verse.VerseNumber, _noteText));
        _status = result.IsSuccess ? (string.IsNullOrWhiteSpace(_noteText) ? "Note removed." : "Note saved.") : result.Error;
        _loadedVerse = -1;
        await OnParametersSetAsync();
    }

    private async Task ToggleLabel(Guid labelId)
    {
        if (_noteId is null)
        {
            return;
        }

        if (!_noteLabels.Remove(labelId))
        {
            _noteLabels.Add(labelId);
        }

        await Mediator.Send(new SetMarkerLabelsCommand(_noteId.Value, [.. _noteLabels]));
    }

    private async Task SetMark(int slot)
    {
        if (Verse is null)
        {
            return;
        }

        var result = await Mediator.Send(new SetProgressMarkCommand(slot, VersionId, BookId, Chapter, Verse.VerseNumber));
        _status = result.IsSuccess ? $"Progress mark {slot} set." : result.Error;
    }

    private async Task Highlight(HighlightColor color)
    {
        if (Verse is null)
        {
            return;
        }

        var result = await Mediator.Send(new SetVerseHighlightCommand(VersionId, BookId, Chapter, Verse.VerseNumber, color));
        _status = result.IsSuccess
            ? (result.Value ? "Highlight saved." : "Highlight removed.")
            : result.Error;
        if (result.IsSuccess && OnChanged.HasDelegate)
        {
            await OnChanged.InvokeAsync();
        }
    }

    private async Task ToggleBookmark()
    {
        if (Verse is null)
        {
            return;
        }

        var result = await Mediator.Send(new ToggleBookmarkCommand(VersionId, BookId, Chapter, Verse.VerseNumber));
        _status = result.IsSuccess
            ? (result.Value!.IsBookmarked ? "Bookmark saved." : "Bookmark removed.")
            : result.Error;
        if (result.IsSuccess && OnChanged.HasDelegate)
        {
            await OnChanged.InvokeAsync();
        }
    }

    private async Task Copy()
    {
        if (Verse is null)
        {
            return;
        }

        var text = $"{BookName} {Chapter}:{Verse.VerseNumber} {Verse.Text}";
        await JS.InvokeVoidAsync("openBibleCopy", text);
        _status = "Copied.";
    }

    private async Task Share()
    {
        if (Verse is null)
        {
            return;
        }

        var text = $"{BookName} {Chapter}:{Verse.VerseNumber} {Verse.Text}";
        var shared = await JS.InvokeAsync<bool>("openBibleShare", text);
        _status = shared ? "Shared." : "Copied (sharing is not supported here).";
    }

    private async Task CloseAsync()
    {
        _status = null;
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
