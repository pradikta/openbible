<div class="error-container">
    <div class="error-icon">⚠️</div>
    <div class="error-message">
        <h4>Terjadi Kesalahan</h4>
        <p>@(Message ?? "Tidak dapat memuat konten.")</p>
    </div>
</div>

<style>
    .error-container {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        background-color: var(--ob-danger-bg);
        border: 1px solid var(--ob-border);
        color: var(--ob-danger);
        border-radius: 8px;
        padding: 1rem;
        margin: 1rem 0;
    }
    .error-icon {
        font-size: 1.5rem;
    }
    .error-message h4 {
        margin: 0 0 0.25rem 0;
        font-weight: 600;
        font-size: 0.95rem;
    }
    .error-message p {
        margin: 0;
        font-size: 0.875rem;
    }
</style>

@code {
    [Parameter] public string? Message { get; set; }
}
